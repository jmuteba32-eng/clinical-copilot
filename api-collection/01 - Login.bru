meta {
  name: 01 - Login
  type: http
  seq: 1
}
post {
  url: {{base_url}}/login
  body: json
  auth: none
}
body:json {
  {
    "username": "{{username}}",
    "password": "{{password}}"
  }
}
script:post-response {
  bru.setEnvVar("token", res.body.token);
}
docs {
  Run this FIRST. Stores the session token for every other request.
  Every PHI-touching endpoint returns 401 without it.
}
